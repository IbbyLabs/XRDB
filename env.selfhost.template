# XRDB minimal self host environment template
#
# Use this file when you want the smallest working setup.
# Copy to .env, set the required values, and keep the rest as needed.
#
# Full template: env.template

# Required for core image rendering: set one TMDB credential
# Preferred server side TMDB read access token
# XRDB_TMDB_READ_ACCESS_TOKEN=
# Optional TMDB v3 API key fallback
XRDB_TMDB_API_KEY=

# Strongly recommended for broader rating coverage
# Shared server side MDBList key
# MDBLIST_API_KEY=

# Optional host level request key for private deployments
# XRDB_REQUEST_API_KEY=

# Local compose options (local-compose.yaml)
# XRDB_PORT=3000
# XRDB_DATA_DIR=./data

# VPS stack options (compose.yaml)
# Required in stack mode: public host name used by Traefik rule
# XRDB_HOSTNAME=xrdb.example.com
#
# Optional stack defaults
# DOCKER_DATA_DIR=./data
# DOCKER_NETWORK=aio_default
# DOCKER_NETWORK_EXTERNAL=true
# XRDB_TRAEFIK_ENTRYPOINTS=websecure
# XRDB_TRAEFIK_CERTRESOLVER=letsencrypt

# Optional but recommended when behind reverse proxy
# XRDB_PREVIEW_ORIGIN=https://xrdb.example.com
