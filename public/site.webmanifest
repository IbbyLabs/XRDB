{
  "name": "XRDB | eXtended Ratings DataBase",
  "short_name": "XRDB",
  "description": "Self hosted artwork engine that adds ratings, quality badges, and visual overlays to Stremio posters and backdrops.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#020108",
  "theme_color": "#020108",
