{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "ci",
          "section": "Build and CI",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "public/product-context.json",
          "jsonpath": "$.xrdbTag"
        }
      ]
    }
  },
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": ""
}
