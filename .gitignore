# Internal development artifacts
bench/
fixtures/bench/
fixtures/parity/

# Build artifacts
web/.next/
web/out/
web/node_modules/
internal/ui/dist/*
# Load bearing: the only tracked file under dist/. `//go:embed all:dist` in
# internal/ui needs the directory to exist in a clean checkout, so deleting this
# stops the binary compiling. A build that clears dist takes it too.
!internal/ui/dist/.keep
web/test-results/
web/playwright-report/
web/.playwright/

# Runtime data
output/
data/
xrdb-cache/
*.db
*.db-shm
*.db-wal

# Secrets and environment
.env
.env.*
!.env.example

# Local notes
.notes

# OS
.DS_Store
Thumbs.db

# Go test cache (local)
*.test

# Settings store sidecar DB
*.db.settings

# Impeccable critique snapshots (local design tooling)
.impeccable/

# Local MCP server config: points at a developer's own state directory and
# credentials, so it is per-machine rather than part of the project.
.mcp.json
