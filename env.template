# XRDB v3 environment template — copy to .env and fill in what you use.
# Full reference: variables.md

# ── Server ───────────────────────────────────────────────────────────
#XRDB_ADDR=:8787
#XRDB_DB=/data/xrdb.db
#XRDB_CACHE_DIR=/data/cache
#XRDB_CACHE_TTL_HOURS=72

# ── Security (set XRDB_ADMIN_KEY on any public instance) ─────────────
#XRDB_ADMIN_KEY=
#XRDB_API_KEY=

# ── Providers (keys can also be entered on the Integrations page) ────
#XRDB_TMDB_READ_TOKEN=
#XRDB_TMDB_API_KEY=
#XRDB_MDBLIST_API_KEY=
#XRDB_OMDB_API_KEY=
#XRDB_FANART_API_KEY=
#XRDB_TRAKT_CLIENT_ID=
#XRDB_SIMKL_CLIENT_ID=
#XRDB_IMDB_DATASET_DIR=

# ── Per-provider cache TTLs (hours) ──────────────────────────────────
#XRDB_TTL_MDBLIST=4
